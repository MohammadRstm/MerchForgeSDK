{
  "name": "@merchforge/storefront-sdk",
  "version": "0.1.0",
  "description": "Shared data/business layer for independent MerchForge storefront applications.",
  "type": "module",
  "license": "UNLICENSED",
  "private": false,
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "workspaces": [
    "example"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "npm run build && npm run dev --workspace example"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
